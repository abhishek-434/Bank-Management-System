# ==============================================================================
# PROFESSIONAL BANKING MANAGEMENT SYSTEM (BMS) - CONFIGURATION
# ==============================================================================

# Database Engine: 'postgresql' or 'sqlite'
DB_ENGINE=postgresql
DB_HOST=localhost
DB_PORT=5432
DB_NAME=bms_db
DB_USER=postgres
DB_PASSWORD=your_secure_password
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_SQLITE_PATH=bms.db

# Test Database Configuration
TEST_DB_ENGINE=sqlite
TEST_DB_NAME=:memory:

# Security & Session Settings
APP_SECRET_KEY=bms-banking-system-secret-key-2026-secure
SESSION_TIMEOUT_MINUTES=30
MAX_LOGIN_ATTEMPTS=5
ACCOUNT_LOCK_MINUTES=15
BCRYPT_ROUNDS=12

# Core Banking Rules
DAILY_WITHDRAWAL_LIMIT=50000.00
MIN_ACCOUNT_BALANCE=100.00
SAVINGS_INTEREST_RATE=3.50
FIXED_DEPOSIT_INTEREST_RATE=6.50
FIXED_DEPOSIT_MIN_TERM_DAYS=30

# User Interface Theme
UI_APPEARANCE_MODE=Dark
UI_COLOR_THEME=blue
WINDOW_DEFAULT_WIDTH=1366
WINDOW_DEFAULT_HEIGHT=850

